# Copy to ~/.secrets/duckking.env. Do not commit the filled file.
# Normal activation obtains the endpoint and token via OTA; no API key is required here.
LINX_OTA_URL=https://xrobo.qiniuapi.com/v1/ota/

# Optional: use provisioned DEVICE credentials instead of OTA.
# LINX_WS_URL=wss://xrobo-io.qiniuapi.com/v1/ws/
# LINX_WS_TOKEN=
# LINX_DEVICE_ID=aa:bb:cc:dd:ee:ff
# LINX_CLIENT_ID=<UUIDv4>

# Optional overrides:
# DUCKKING_DATA_DIR=~/.local/share/duckking
# DUCKKING_OPUS_LIBRARY=/opt/homebrew/lib/libopus.dylib

# Public demo rooms are created on demand. Each cloud room needs its own bound identity.
DUCKKING_MAX_ROOMS=10
DUCKKING_MAX_PHYSICS_ROOMS=4
DUCKKING_ROOM_IDLE_SECONDS=300

# Optional: prepare one unused ball world while no physical/voice room is active.
DUCKKING_PHYSICS_PREWARM=0

# Optional: region-based default UI language (Europe excluding UK -> French UI).
# Proxy headers are trusted only when the socket peer is configured below.
# Untrusted forwarded headers are ignored; the French UI then fails back to zh.
# DUCKKING_GEO_DB_DIR=~/.local/share/duckking/geo
# Add only verified proxy source IPs/CIDRs; do not trust an entire subnet.
# DUCKKING_GEO_TRUSTED_PROXIES=127.0.0.1/32,::1/128,<OR_UPSTREAM_SOURCE_IP>/32

# Optional: behind a gateway that already asserts the visitor country
# (e.g. CF-IPCountry), prefer that header over the local database.
# DUCKKING_GEO_COUNTRY_HEADER=

# Optional pool of rooms independently bound to French-configured agents.
# Busy French voice rooms are never shared; exhausted pools fall back to an independent default room.
# DUCKKING_FRENCH_ROOMS=2,3

# Optional: rooms provisioned with --lang-code en for US/UK visitors
# (English UI + English recognition). Same rules as the French pool.
# DUCKKING_ENGLISH_ROOMS=4
