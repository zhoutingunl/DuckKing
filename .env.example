# Copy to ~/.secrets/duckking.env. Do not commit the filled file.
# Normal activation obtains the endpoint and token via OTA; no API key is required here.
LINX_OTA_URL=https://xrobo.qiniuapi.com/v1/ota/

# Optional: use provisioned DEVICE credentials instead of OTA.
# LINX_WS_URL=wss://xrobo-io.qiniuapi.com/v1/ws/
# LINX_WS_TOKEN=
# LINX_DEVICE_ID=aa:bb:cc:dd:ee:ff
# LINX_CLIENT_ID=<UUIDv4>

# Optional overrides:
# DUCKKING_DATA_DIR=~/.local/share/duckking
# DUCKKING_OPUS_LIBRARY=/opt/homebrew/lib/libopus.dylib

# Public demo rooms are created on demand. Each cloud room needs its own bound identity.
DUCKKING_MAX_ROOMS=10
DUCKKING_MAX_PHYSICS_ROOMS=4
DUCKKING_ROOM_IDLE_SECONDS=300
