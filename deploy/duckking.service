[Unit]
Description=DuckKing independent voice and MuJoCo service
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=duckking
Group=duckking
WorkingDirectory=/opt/duckking/current
Environment=DUCKKING_BIND_HOST=127.0.0.1
Environment=DUCKKING_DATA_DIR=/var/lib/duckking
Environment=DUCKKING_RELEASE_FILE=/opt/duckking/current/release.json
Environment=DUCKKING_DEPLOY_HISTORY=/var/lib/duckking/deployments.jsonl
Environment=DUCKKING_SECRETS_FILE=/etc/duckking/voice.env
Environment=OPENBLAS_NUM_THREADS=1
Environment=OMP_NUM_THREADS=1
EnvironmentFile=-/etc/duckking/runtime.env
ExecStart=/opt/duckking/current/.venv/bin/duckking --host ${DUCKKING_BIND_HOST} --port 8765 --allowed-host ztmonitor.qbox.net --root-path /duckking
Restart=on-failure
RestartSec=3
TimeoutStopSec=20
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/duckking
CPUQuota=150%
MemoryMax=2G
TasksMax=128

[Install]
WantedBy=multi-user.target
